	<!-- =============================== DAGGERS (role-split) =============================== -->
	<!-- Rogue/Elven Scout/Assassin are SHARED with the archer lines, hence role="DAGGER".
	     Backstab and Deadly Blow only arrive at 40; 20-39 is carried by Mortal Blow and Bleed.
	     PvP follows the Interlude dagger guides. Ultimate Evasion is the first cast of every new fight with a player
	     (listed above the stance; the PVP condition skips it against monsters) and still saves a low-HP dagger when
	     it is ready. Vicious Stance stays on in a fight. Trick or Switch makes a player that has the dagger selected
	     drop it. Bluff turns the enemy around for Backstab but only arrives at 77; before that the dagger walks to
	     the target's back while the target is busy or stunned. -->

	<playstyle name="Dagger (Human)" classIds="7,8,93" role="DAGGER">
		<skill id="111" name="Ultimate Evasion" use="OPENER"   when="PVP" />
