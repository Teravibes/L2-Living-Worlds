	<!-- Bounty Hunter line: durable melee assist. Spoil economy integration comes later. Dwarves fight with a
	     blunt; a party member also carries a polearm (PhantomWeaponSets), and the pole AoEs below fire only while
	     the leader has it switch to that polearm. -->
	<playstyle name="Fortune Seeker" classIds="54,55,117">
		<!-- Spoil first - it has to land BEFORE the thing dies to be worth anything, and it is the whole
		     economic point of the class. NOT_SPOILED reads the mob's real spoil state instead of a
		     fire-once ledger: a resisted attempt leaves the mob unspoiled so the phantom RETRIES, and an
		     already-spoiled mob is skipped so no MP is wasted. Festival uses MOBS_UNSPOILED so it only
		     fires when enough of the pack still needs spoiling. (Sweeper is corpse-targeted and still
		     needs loot handling - deferred.) -->
		<skill id="254" name="Spoil"        use="DEBUFF"   when="NOT_SPOILED" />
		<skill id="302" name="Spoil Festival" use="AOE"    when="MOBS_UNSPOILED" mobsAtLeast="3" paceMs="10000" />
		<skill id="100" name="Stun Attack"  use="CONTROL"  when="DEBUFF_MISSING" paceMs="5000" />
		<skill id="260" name="Hammer Crush" use="CONTROL"  when="DEBUFF_MISSING" paceMs="6000" />
