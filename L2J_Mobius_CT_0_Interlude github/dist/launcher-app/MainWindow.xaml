<Window x:Class="LivingWorld.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Living World Launcher" Height="640" Width="1000"
        WindowStartupLocation="CenterScreen" ResizeMode="CanMinimize"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        FontFamily="Segoe UI" TextOptions.TextFormattingMode="Ideal">

  <Window.Resources>
    <!-- Palette -->
    <SolidColorBrush x:Key="Gold"      Color="#C9A15A"/>
    <SolidColorBrush x:Key="GoldDim"   Color="#8A7448"/>
    <SolidColorBrush x:Key="Ink"       Color="#EDE3D2"/>
    <SolidColorBrush x:Key="InkDim"    Color="#9C9385"/>
    <SolidColorBrush x:Key="Card"      Color="#CC15110C"/>
    <SolidColorBrush x:Key="CardEdge"  Color="#33C9A15A"/>

    <!-- Window chrome buttons (min / close) -->
    <Style x:Key="Chrome" TargetType="Button">
      <Setter Property="Foreground" Value="#D8CDBB"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" Background="{TemplateBinding Background}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="b" Property="Background" Value="#33FFFFFF"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Secondary (flat) buttons -->
    <Style x:Key="Flat" TargetType="Button">
      <Setter Property="Foreground" Value="{StaticResource Ink}"/>
      <Setter Property="Background" Value="#26120E08"/>
      <Setter Property="BorderBrush" Value="{StaticResource CardEdge}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" CornerRadius="6" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                    Padding="12,8">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="b" Property="Background" Value="#3A1D140B"/>
                <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource Gold}"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.45"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Primary Play / Stop buttons -->
    <Style x:Key="Hero" TargetType="Button">
      <Setter Property="Foreground" Value="#F7EFDD"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FontFamily" Value="Georgia"/>
      <Setter Property="FontSize" Value="21"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" CornerRadius="8" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="b" Property="Opacity" Value="0.88"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.4"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- News item card -->
    <DataTemplate x:Key="NewsTemplate">
      <Border Background="#22000000" BorderBrush="{StaticResource CardEdge}" BorderThickness="1"
              CornerRadius="6" Padding="14,10" Margin="0,0,0,10">
        <StackPanel>
          <DockPanel>
            <TextBlock Text="{Binding DateText}" DockPanel.Dock="Right" Foreground="{StaticResource InkDim}"
                       FontSize="11" VerticalAlignment="Center"/>
            <TextBlock Text="{Binding Title}" Foreground="{StaticResource Gold}" FontFamily="Georgia"
                       FontSize="15" TextTrimming="CharacterEllipsis"/>
          </DockPanel>
          <TextBlock Text="{Binding Body}" Foreground="{StaticResource Ink}" FontSize="12.5"
                     TextWrapping="Wrap" Margin="0,6,0,0" MaxHeight="72" TextTrimming="CharacterEllipsis"/>
        </StackPanel>
      </Border>
    </DataTemplate>
  </Window.Resources>

  <Border x:Name="RootShell" CornerRadius="10" ClipToBounds="True" Background="#0B0906"
          BorderBrush="#55000000" BorderThickness="1">
    <Grid>
      <!-- Artwork -->
      <Image x:Name="BgImage" Stretch="UniformToFill" Panel.ZIndex="0"/>
      <Border Panel.ZIndex="1">
        <Border.Background>
          <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#59000000" Offset="0"/>
            <GradientStop Color="#8A0A0805" Offset="0.55"/>
            <GradientStop Color="#F00A0805" Offset="1"/>
          </LinearGradientBrush>
        </Border.Background>
      </Border>

      <Grid Panel.ZIndex="2" Margin="0">
        <Grid.RowDefinitions>
          <RowDefinition Height="42"/>
          <RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title bar -->
        <Grid x:Name="TitleBar" Grid.Row="0" Background="#40000000">
          <TextBlock Text="LIVING  WORLD" Margin="18,0,0,0" VerticalAlignment="Center"
                     Foreground="{StaticResource Gold}" FontFamily="Georgia" FontSize="15"/>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="MinButton" Width="44" Style="{StaticResource Chrome}" FontSize="16" Content="&#8211;"/>
            <Button x:Name="CloseButton" Width="44" Style="{StaticResource Chrome}" FontSize="14" Content="&#10005;"/>
          </StackPanel>
        </Grid>

        <!-- Body -->
        <Grid Grid.Row="1" Margin="18,10,18,6">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="18"/>
            <ColumnDefinition Width="360"/>
          </Grid.ColumnDefinitions>

          <!-- News -->
          <Border Grid.Column="0" Background="{StaticResource Card}" BorderBrush="{StaticResource CardEdge}"
                  BorderThickness="1" CornerRadius="8">
            <Grid Margin="16,14">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
              </Grid.RowDefinitions>
              <TextBlock Grid.Row="0" Text="NEWS" Foreground="{StaticResource GoldDim}" FontSize="12"
                         FontWeight="Bold" Margin="2,0,0,10"/>
              <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                  <ItemsControl x:Name="NewsList" ItemTemplate="{StaticResource NewsTemplate}"/>
                  <TextBlock x:Name="NewsEmpty" Foreground="{StaticResource InkDim}" FontSize="12.5"
                             TextWrapping="Wrap" Visibility="Collapsed"/>
                </StackPanel>
              </ScrollViewer>
            </Grid>
          </Border>

          <!-- Right column -->
          <Grid Grid.Column="2">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Status -->
            <Border Grid.Row="0" Background="{StaticResource Card}" BorderBrush="{StaticResource CardEdge}"
                    BorderThickness="1" CornerRadius="8" Padding="16,14">
              <StackPanel>
                <TextBlock Text="SERVER STATUS" Foreground="{StaticResource GoldDim}" FontSize="12"
                           FontWeight="Bold" Margin="0,0,0,10"/>
                <Grid Margin="0,3">
                  <Ellipse x:Name="DbDot" Width="10" Height="10" HorizontalAlignment="Left" Fill="#555"/>
                  <TextBlock Text="Database" Margin="20,0,0,0" Foreground="{StaticResource Ink}" FontSize="13"/>
                  <TextBlock x:Name="DbState" HorizontalAlignment="Right" Foreground="{StaticResource InkDim}" FontSize="12" Text="offline"/>
                </Grid>
                <Grid Margin="0,3">
                  <Ellipse x:Name="LoginDot" Width="10" Height="10" HorizontalAlignment="Left" Fill="#555"/>
                  <TextBlock Text="Login server" Margin="20,0,0,0" Foreground="{StaticResource Ink}" FontSize="13"/>
                  <TextBlock x:Name="LoginState" HorizontalAlignment="Right" Foreground="{StaticResource InkDim}" FontSize="12" Text="offline"/>
                </Grid>
                <Grid Margin="0,3">
                  <Ellipse x:Name="GameDot" Width="10" Height="10" HorizontalAlignment="Left" Fill="#555"/>
                  <TextBlock Text="Game server" Margin="20,0,0,0" Foreground="{StaticResource Ink}" FontSize="13"/>
                  <TextBlock x:Name="GameState" HorizontalAlignment="Right" Foreground="{StaticResource InkDim}" FontSize="12" Text="offline"/>
                </Grid>
                <Grid Margin="0,3">
                  <Ellipse x:Name="BrainDot" Width="10" Height="10" HorizontalAlignment="Left" Fill="#555"/>
                  <TextBlock Text="FPC brain" Margin="20,0,0,0" Foreground="{StaticResource Ink}" FontSize="13"/>
                  <TextBlock x:Name="BrainState" HorizontalAlignment="Right" Foreground="{StaticResource InkDim}" FontSize="12" Text="offline"/>
                </Grid>

                <Border Height="1" Background="{StaticResource CardEdge}" Margin="0,12,0,10"/>
                <DockPanel>
                  <TextBlock x:Name="VersionText" DockPanel.Dock="Left" Foreground="{StaticResource InkDim}" FontSize="12" Text="Version: -"/>
                  <TextBlock x:Name="UpdateText" HorizontalAlignment="Right" Foreground="{StaticResource Gold}" FontSize="12" Text=""/>
                </DockPanel>
                <Grid Margin="0,12,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <Button x:Name="SettingsButton" Grid.Column="0" Style="{StaticResource Flat}" Content="Settings"/>
                  <Button x:Name="UpdateButton" Grid.Column="2" Style="{StaticResource Flat}" Content="Check for updates"/>
                </Grid>
                <Grid Margin="0,8,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <Button x:Name="ConfigButton" Grid.Column="0" Style="{StaticResource Flat}" Content="Config Editor"/>
                  <Button x:Name="ModulesButton" Grid.Column="2" Style="{StaticResource Flat}" Content="Modules"/>
                </Grid>
                <Grid Margin="0,8,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <Button x:Name="BackupButton" Grid.Column="0" Style="{StaticResource Flat}" Content="Back up progress"/>
                  <Button x:Name="RestoreButton" Grid.Column="2" Style="{StaticResource Flat}" Content="Restore progress"/>
                </Grid>
              </StackPanel>
            </Border>

            <!-- Log -->
            <Border Grid.Row="2" Margin="0,12,0,0" Background="#CC0A0805" BorderBrush="{StaticResource CardEdge}"
                    BorderThickness="1" CornerRadius="8">
              <Grid Margin="14,12">
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="LOG" Foreground="{StaticResource GoldDim}" FontSize="12" FontWeight="Bold" Margin="0,0,0,6"/>
                <TextBox x:Name="LogBox" Grid.Row="1" Background="Transparent" Foreground="#B7C7A6"
                         BorderThickness="0" IsReadOnly="True" FontFamily="Consolas" FontSize="12"
                         VerticalScrollBarVisibility="Auto" TextWrapping="Wrap"/>
              </Grid>
            </Border>
          </Grid>
        </Grid>

        <!-- Bottom bar -->
        <Border Grid.Row="2" Background="#B3050403" BorderBrush="#33C9A15A" BorderThickness="0,1,0,0">
          <Grid Margin="18,14,18,16">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="16"/>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="10"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" VerticalAlignment="Center">
              <TextBlock x:Name="StageText" Foreground="{StaticResource Ink}" FontSize="13" Text="Ready to launch."/>
              <ProgressBar x:Name="Progress" Height="10" Margin="0,8,0,0" Minimum="0" Maximum="1" Value="0"
                           Background="#33000000" Foreground="{StaticResource Gold}" BorderThickness="0"/>
            </StackPanel>

            <Button x:Name="StopButton" Grid.Column="2" Width="128" Height="62" Content="Stop"
                    Style="{StaticResource Hero}" Background="#4A2422" BorderBrush="#6A3030" IsEnabled="False"/>
            <Button x:Name="PlayButton" Grid.Column="4" Width="210" Height="62" Content="PLAY"
                    Style="{StaticResource Hero}" Background="#33582C" BorderBrush="#4E7B3C"/>
          </Grid>
        </Border>
      </Grid>
    </Grid>
  </Border>
</Window>
